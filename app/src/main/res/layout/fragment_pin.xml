<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/textTitoloPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inserisci il PIN"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:hint="PIN (4 cifre)"
        android:inputType="numberPassword"
        android:maxLength="4" />

    <EditText
        android:id="@+id/editConfermaPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:hint="Conferma PIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnConferma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Avanti" />

    <Button
        android:id="@+id/btnImpronta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sblocca con impronta"
        android:visibility="gone" />

</LinearLayout>